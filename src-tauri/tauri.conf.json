{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContractorCRM",
  "version": "0.1.0",
  "identifier": "com.contractorkeith.contractorcrm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ContractorCRM",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self' asset:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ContractorKeith",
    "copyright": "Copyright (C) 2026 ContractorKeith. Licensed under the GNU AGPL-3.0-only.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
